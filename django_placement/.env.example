# ====================================================================
# NFSU Student Placement Management System - Environment Configuration
# National Forensic Sciences University • Placement Session 2026–27
# ====================================================================

SECRET_KEY=django-insecure-nfsu-placement-crypto-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (MySQL / SQLite fallback)
# Set DB_ENGINE=mysql when running with MySQL / XAMPP, or sqlite for standalone development
DB_ENGINE=sqlite
DB_NAME=nfsu_placement_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Security & Session Settings
SESSION_COOKIE_AGE=28800
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
CSRF_COOKIE_HTTPONLY=True
X_FRAME_OPTIONS=DENY
